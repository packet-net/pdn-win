<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <Version>0.0.0-dev</Version>
    <Authors>Tom Fanning M0LTE and Packet.NET contributors</Authors>
    <Company>Packet.NET</Company>
    <Copyright>Copyright (c) 2026 Tom Fanning and Packet.NET contributors</Copyright>
    <!-- Everything here is AGPL-3.0-or-later (see LICENSE). -->
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>

  <!-- pdn-soundmodem comes from NuGet (pdn-soundmodem and pdn-soundmodem-windows, pinned in
       Directory.Packages.props). To build against a local checkout while changing both repos at
       once, pass -p:PdnSoundModemRoot=C:\path\to\pdn-soundmodem, the same pattern as
       pdn-soundmodem's own FlexSourcePath: the two package references become project
       references. Unset, which is what CI and releases do, the pinned packages are used. -->

</Project>
