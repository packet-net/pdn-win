<Project>
  <ItemGroup>
    <!-- packet.net: the AX.25 stack. AGPL-3.0-or-later. -->
    <PackageVersion Include="Packet.Core" Version="0.41.0" />
    <PackageVersion Include="Packet.Ax25" Version="0.41.0" />

    <!-- pdn-soundmodem: the modem core (GPL-3.0-or-later) and its Windows and Linux radio
         interface libraries (AGPL-3.0-or-later), released together on one version. -->
    <PackageVersion Include="pdn-soundmodem" Version="0.82.0" />
    <PackageVersion Include="pdn-soundmodem-windows" Version="0.82.0" />
    <PackageVersion Include="pdn-soundmodem-linux" Version="0.82.0" />

    <!-- Serial port enumeration for PTT. MIT. -->
    <PackageVersion Include="System.IO.Ports" Version="10.0.11" />

    <!-- Avalonia: the cross-platform front-end (spike). MIT. -->
    <PackageVersion Include="Avalonia" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.3" />

    <!-- MVVM source generators for the WPF app. MIT. -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />

    <!-- Testing, as packet.net and pdn-soundmodem: xUnit v3 on MTP, AwesomeAssertions. -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="AwesomeAssertions" Version="9.2.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.0.0" />
  </ItemGroup>
</Project>
