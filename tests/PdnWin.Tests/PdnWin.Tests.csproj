<Project Sdk="Microsoft.NET.Sdk">

  <!-- The front-end, driven without a display through Avalonia's headless platform: windows are
       built, shown, laid out and poked as an operator would, so CI on Linux and Windows checks
       the views and not only the view models. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <!-- Test method names read as sentences (packet.net house style). -->
    <NoWarn>$(NoWarn);CA1707;CA1861;xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Avalonia.Headless" />
    <ProjectReference Include="..\..\src\PdnWin\PdnWin.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="AwesomeAssertions" />
  </ItemGroup>

</Project>
