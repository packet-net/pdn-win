<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:PdnWin.ViewModels;assembly=PdnWin.Presentation"
                    xmlns:mon="clr-namespace:PdnWin.Core.Monitoring;assembly=PdnWin.Core"
                    xmlns:ses="clr-namespace:PdnWin.Core.Sessions;assembly=PdnWin.Core">

    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!-- A monitor row: time, direction, the BPQ header coloured by frame kind, then the text and
         the receive diagnostics indented under it. Our own frames carry a cyan rule. -->
    <DataTemplate DataType="{x:Type vm:MonitorItem}">
        <Border x:Name="Row" BorderThickness="2,0,0,0" BorderBrush="Transparent" Padding="8,1,8,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="62" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Time, Mode=OneTime}" Style="{StaticResource MonoText}" Foreground="{StaticResource Muted}" />
                <TextBlock x:Name="Dir" Grid.Column="1" Text="{Binding Direction, Mode=OneTime}" Style="{StaticResource MonoText}"
                           FontSize="10" VerticalAlignment="Top" Margin="0,2,0,0" Foreground="#4A5563" />
                <StackPanel Grid.Column="2">
                    <TextBlock x:Name="Head" Text="{Binding Header, Mode=OneTime}" Style="{StaticResource MonoText}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Info, Mode=OneTime}" Style="{StaticResource MonoText}" TextWrapping="Wrap" Foreground="{StaticResource Ink}"
                               Margin="14,0,0,0" x:Name="Info" />
                    <StackPanel Orientation="Horizontal" x:Name="DetailRow" Margin="14,1,0,1">
                        <TextBlock Text="{Binding Detail, Mode=OneTime}" Style="{StaticResource MonoText}" FontSize="10.5" Foreground="{StaticResource Muted}" />
                        <Border x:Name="Badge" Background="#7A1F14" CornerRadius="3" Padding="5,0" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Badge, Mode=OneTime}" FontSize="9" FontWeight="Bold" Foreground="#FFD0C4" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Kind, Mode=OneTime}" Value="{x:Static mon:FrameKind.Information}">
                <Setter TargetName="Head" Property="Foreground" Value="#8CCBF5" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind, Mode=OneTime}" Value="{x:Static mon:FrameKind.Supervisory}">
                <Setter TargetName="Head" Property="Foreground" Value="{StaticResource AmberDim}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind, Mode=OneTime}" Value="{x:Static mon:FrameKind.Unnumbered}">
                <Setter TargetName="Head" Property="Foreground" Value="{StaticResource Violet}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind, Mode=OneTime}" Value="{x:Static mon:FrameKind.UnnumberedInformation}">
                <Setter TargetName="Head" Property="Foreground" Value="{StaticResource Live}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind, Mode=OneTime}" Value="{x:Static mon:FrameKind.Reject}">
                <Setter TargetName="Head" Property="Foreground" Value="{StaticResource Bad}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind, Mode=OneTime}" Value="{x:Static mon:FrameKind.Undecodable}">
                <Setter TargetName="Head" Property="Foreground" Value="{StaticResource Muted}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsTx, Mode=OneTime}" Value="True">
                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Tx}" />
                <Setter TargetName="Row" Property="Background" Value="#0E31D2F2" />
                <Setter TargetName="Dir" Property="Foreground" Value="{StaticResource Tx}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Info, Mode=OneTime}" Value="{x:Null}">
                <Setter TargetName="Info" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Detail, Mode=OneTime}" Value="{x:Null}">
                <Setter TargetName="DetailRow" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Badge, Mode=OneTime}" Value="{x:Null}">
                <Setter TargetName="Badge" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A transcript line: theirs in ink, ours in amber, the session's own notices muted. -->
    <DataTemplate DataType="{x:Type vm:TranscriptLine}">
        <Grid Margin="10,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="Time" Text="{Binding Time, Mode=OneTime}" Style="{StaticResource MonoText}" FontSize="10.5"
                       Foreground="#3E4855" VerticalAlignment="Top" Margin="0,1,0,0" />
            <TextBlock x:Name="Body" Grid.Column="1" Text="{Binding Text}" Style="{StaticResource MonoText}" FontSize="13"
                       TextWrapping="Wrap" />
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Kind, Mode=OneTime}" Value="{x:Static ses:SessionLineKind.Sent}">
                <Setter TargetName="Body" Property="Foreground" Value="{StaticResource Amber}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind, Mode=OneTime}" Value="{x:Static ses:SessionLineKind.Notice}">
                <Setter TargetName="Body" Property="Foreground" Value="{StaticResource Muted}" />
                <Setter TargetName="Body" Property="FontStyle" Value="Italic" />
                <Setter TargetName="Body" Property="FontSize" Value="12" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A heard station. -->
    <DataTemplate DataType="{x:Type vm:HeardStation}">
        <Border Padding="12,6" BorderBrush="#141A23" BorderThickness="0,0,0,1">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Ago}" Style="{StaticResource MonoText}" FontSize="11" Foreground="{StaticResource Muted}" />
                    <TextBlock Text="{Binding Call, Mode=OneTime}" Style="{StaticResource MonoText}" FontWeight="SemiBold" Foreground="{StaticResource Amber}" />
                </DockPanel>
                <TextBlock Style="{StaticResource MonoText}" FontSize="10.5" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis">
                    <Run Text="&gt; " /><Run Text="{Binding LastTo}" Foreground="{StaticResource Ink}" />
                    <Run Text="  " /><Run Text="{Binding Frames}" /><Run Text=" fr  " /><Run Text="{Binding Quality}" />
                </TextBlock>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- A session tab header: link-state dot, callsign, unread dot, close. -->
    <DataTemplate x:Key="SessionTabHeader" DataType="{x:Type vm:SessionTabViewModel}">
        <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="Dot" Width="7" Height="7" Fill="#3E4855" Margin="0,0,7,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Title}" FontFamily="{StaticResource Mono}" FontSize="12" VerticalAlignment="Center"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
            <Ellipse x:Name="Unread" Width="6" Height="6" Fill="{StaticResource Amber}" Margin="6,0,0,0" VerticalAlignment="Center"
                     Visibility="{Binding HasUnread, Converter={StaticResource BoolToVis}}" />
            <Button x:Name="CloseButton" Style="{StaticResource GhostButton}" Command="{Binding CloseCommand}" Padding="4" Margin="5,0,-4,0"
                    ToolTip="Close this session">
                <Path Data="M 0,0 L 6,6 M 6,0 L 0,6" Stroke="{StaticResource Muted}" StrokeThickness="1.3" />
            </Button>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsConsole}" Value="True">
                <Setter TargetName="CloseButton" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Dot" Property="Fill" Value="{StaticResource AmberDim}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Live}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Amber}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>
