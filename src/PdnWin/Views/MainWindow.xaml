<Window x:Class="PdnWin.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:PdnWin.Controls"
        xmlns:d="clr-namespace:PdnWin.Docking"
        xmlns:vm="clr-namespace:PdnWin.ViewModels;assembly=PdnWin.Presentation"
        Title="pdn-win" Icon="/Assets/pdn-win.ico" Width="1440" Height="900" MinWidth="980" MinHeight="600"
        Background="{StaticResource Bg}" Foreground="{StaticResource Ink}"
        FontFamily="{StaticResource Sans}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverFill}" />
                                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseCaption" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C42B1C" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Chrome" TargetType="FrameworkElement">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        </Style>
        <Style x:Key="Group" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,22,0" />
        </Style>
        <Style x:Key="TxTestButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Content" Value="Send tone" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding TxTestRunning}" Value="True">
                    <Setter Property="Content" Value="Stop" />
                    <Setter Property="Background" Value="{StaticResource Amber}" />
                    <Setter Property="Foreground" Value="#12141A" />
                    <Setter Property="BorderBrush" Value="{StaticResource Amber}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="Frame" BorderBrush="{StaticResource Edge}" BorderThickness="1">
        <DockPanel>

            <!-- Title bar: the wordmark, the station's state, lamps, and the window's own buttons. -->
            <Grid DockPanel.Dock="Top" Height="40" Background="{StaticResource Panel}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Path Data="M0,9 L4,9 L6,3 L9,15 L12,6 L14,9 L18,9" Stroke="{StaticResource Amber}" StrokeThickness="1.8"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock FontFamily="{StaticResource Mono}" FontSize="14" VerticalAlignment="Center">
                        <Run Text="pdn" Foreground="{StaticResource Amber}" FontWeight="SemiBold" /><Run Text="-win" Foreground="{StaticResource Muted}" />
                    </TextBlock>
                    <TextBlock Text="{Binding Version}" FontFamily="{StaticResource Mono}" FontSize="10" Foreground="#4A5563"
                               VerticalAlignment="Center" Margin="7,2,0,0" />

                    <!-- Station pill -->
                    <Border x:Name="Pill" Margin="18,0,0,0" CornerRadius="11" Padding="9,3,11,3" Background="#0FFFFFFF" VerticalAlignment="Center"
                            Style="{StaticResource Chrome}" ToolTip="{Binding StatusText}">
                        <StackPanel Orientation="Horizontal">
                            <c:Lamp x:Name="StatusLamp" Width="10" Height="10" IsOn="True" Color="#7C8894" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding InterfaceName}" FontSize="12" Margin="7,0,0,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="StateWord" Text="offline" FontSize="12" Margin="6,0,0,0" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Lamps and callsign, centre-right -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0" ToolTip="Channel busy: someone else is transmitting">
                        <c:Lamp IsOn="{Binding ChannelBusy}" Color="#7BD88F" Width="12" Height="12" />
                        <TextBlock Text="DCD" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,18,0" ToolTip="We are transmitting">
                        <c:Lamp IsOn="{Binding Transmitting}" Color="#FF5A42" Width="12" Height="12" />
                        <TextBlock Text="TX" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Border Background="{StaticResource AmberGlass}" BorderBrush="{StaticResource AmberDim}" BorderThickness="1" CornerRadius="5" Padding="9,2"
                            VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Your callsign" x:Name="CallBadge">
                        <TextBlock Text="{Binding MyCall}" FontFamily="{StaticResource Mono}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Amber}" />
                    </Border>
                    <Button Style="{StaticResource GhostButton}" WindowChrome.IsHitTestVisibleInChrome="True" Margin="12,0,0,0" Padding="8,4"
                            Command="{Binding ShowLevelHelperCommand}" ToolTip="Set levels" AutomationProperties.Name="Levels">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M1,2 H13 M1,7 H13 M1,12 H13 M4,0 V4 M10,5 V9 M6,10 V14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.4" />
                            <TextBlock Text="Levels" Margin="6,0,0,0" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ViewButton" Style="{StaticResource GhostButton}" WindowChrome.IsHitTestVisibleInChrome="True" Padding="8,4" Click="OnViewMenu"
                            ToolTip="Show or hide panes" AutomationProperties.Name="View">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M0.5,0.5 H13.5 V13.5 H0.5 Z M0.5,5 H13.5 M6,5 V13.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.2" />
                            <TextBlock Text="View" Margin="6,0,0,0" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" WindowChrome.IsHitTestVisibleInChrome="True" Padding="8,4" Command="{Binding OpenSettingsCommand}"
                            ToolTip="Settings" AutomationProperties.Name="Settings">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M7,4.5 A2.5,2.5 0 1 1 6.99,4.5 M7,0.5 V2.5 M7,11.5 V13.5 M0.5,7 H2.5 M11.5,7 H13.5 M2.4,2.4 L3.8,3.8 M10.2,10.2 L11.6,11.6 M2.4,11.6 L3.8,10.2 M10.2,3.8 L11.6,2.4"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" />
                            <TextBlock Text="Settings" Margin="6,0,0,0" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Style="{StaticResource CaptionButton}" Click="OnMinimize" ToolTip="Minimise" AutomationProperties.Name="Minimise">
                        <Path Data="M0,0.5 H10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" Click="OnMaximize" ToolTip="Maximise" AutomationProperties.Name="Maximise">
                        <Path x:Name="MaxGlyph" Data="M0.5,0.5 H9.5 V9.5 H0.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
                    </Button>
                    <Button Style="{StaticResource CloseCaption}" Click="OnClose" ToolTip="Close" AutomationProperties.Name="Close">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Control strip: mode, receive and transmit levels with the meter, the tone test, the beacon. -->
            <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="0,1,0,1" Padding="16,7">
                <WrapPanel VerticalAlignment="Center">
                    <StackPanel Style="{StaticResource Group}">
                        <TextBlock Text="MODE" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" Width="150" FontFamily="{StaticResource Mono}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ModeChoice}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Mode}" FontFamily="{StaticResource Mono}" />
                                        <TextBlock Text="{Binding Description}" FontSize="10.5" Foreground="{StaticResource Muted}"
                                                   FontFamily="{StaticResource Sans}" x:Name="Desc" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" Value="{x:Null}">
                                            <Setter TargetName="Desc" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Style="{StaticResource Group}" IsEnabled="{Binding LevelsAvailable}">
                        <TextBlock Text="RX" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Slider Width="90" Minimum="{Binding RxMinDb}" Maximum="{Binding RxMaxDb}" Value="{Binding RxLevelDb}" SmallChange="0.5" LargeChange="3"
                                VerticalAlignment="Center" ToolTip="Windows receive level (never above 0 dB). Set the radio's volume first." />
                        <TextBlock Text="{Binding RxLevelDb, StringFormat='{}{0:0.0} dB'}" FontFamily="{StaticResource Mono}" FontSize="11" Width="50"
                                   VerticalAlignment="Center" Margin="8,0,10,0" TextAlignment="Right" />
                        <c:LevelMeter PeakDb="{Binding PeakDb}" RmsDb="{Binding RmsDb}" Width="150" Height="12" VerticalAlignment="Center"
                                      ToolTip="Input peak, -60 to 0 dBFS. Aim for -18 to -9 (green) on open-squelch noise; never red." />
                        <TextBlock Text="{Binding LevelText}" FontFamily="{StaticResource Mono}" FontSize="11" Width="76" Margin="8,0,0,0"
                                   VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
                        <Border Background="#7A1F14" CornerRadius="3" Padding="5,1" VerticalAlignment="Center"
                                Visibility="{Binding Clipping, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="CLIP" FontSize="9" FontWeight="Bold" Foreground="#FFD0C4" />
                        </Border>
                    </StackPanel>

                    <StackPanel Style="{StaticResource Group}" IsEnabled="{Binding LevelsAvailable}">
                        <TextBlock Text="TX" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Slider Width="90" Minimum="{Binding TxMinDb}" Maximum="{Binding TxMaxDb}" Value="{Binding TxLevelDb}" SmallChange="0.5" LargeChange="2"
                                VerticalAlignment="Center" ToolTip="Windows transmit level (never above 0 dB). Set it with the tone test." />
                        <TextBlock Text="{Binding TxLevelDb, StringFormat='{}{0:0.0} dB'}" FontFamily="{StaticResource Mono}" FontSize="11" Width="50"
                                   VerticalAlignment="Center" Margin="8,0,0,0" TextAlignment="Right" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource Group}">
                        <TextBlock Text="TONE" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding TxTestPresets}" SelectedItem="{Binding SelectedPreset}" Width="96"
                                  ToolTip="{Binding SelectedPreset.Label}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TxTestPreset}">
                                    <TextBlock FontFamily="{StaticResource Mono}">
                                        <Run Text="{Binding ToneHz, StringFormat='{}{0:0} Hz', Mode=OneTime}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Style="{StaticResource TxTestButton}" Command="{Binding ToggleTxTestCommand}" Margin="6,0,0,0" Padding="10,3"
                                IsEnabled="{Binding IsLive}" ToolTip="Transmit a test tone. This keys the radio." />
                    </StackPanel>

                    <StackPanel Style="{StaticResource Group}">
                        <Button Content="Beacon now" Command="{Binding SendBeaconNowCommand}" Padding="10,3" IsEnabled="{Binding IsLive}"
                                ToolTip="Send the beacon text now" />
                    </StackPanel>
                </WrapPanel>
            </Border>

            <!-- Status bar -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="0,1,0,0" Padding="14,4">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Muted}">
                            <Run Text="rx " /><Run Text="{Binding FramesHeard}" Foreground="{StaticResource Ink}" /><Run Text="   tx " /><Run Text="{Binding FramesSent}" Foreground="{StaticResource Ink}" />
                        </TextBlock>
                    </StackPanel>
                    <TextBlock x:Name="Hygiene" DockPanel.Dock="Right" Text="{Binding HygieneWarning}" FontSize="11" Foreground="#FFCF9A" Margin="0,0,18,0"
                               TextTrimming="CharacterEllipsis" MaxWidth="480" />
                    <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>

            <d:DockHost x:Name="Dock" Margin="6" />
        </DockPanel>
    </Border>
</Window>
