<UserControl x:Class="PdnWin.Views.InputPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="8,6" VerticalAlignment="Center">
        <TextBlock DockPanel.Dock="Left" Text="{Binding Sessions.Prompt}" FontFamily="{StaticResource Mono}" FontSize="13"
                   Foreground="{StaticResource Amber}" VerticalAlignment="Center" Margin="2,0,10,0" />
        <Button DockPanel.Dock="Right" Content="Send" Command="{Binding Sessions.SendCommand}" Style="{StaticResource AccentButton}"
                Margin="8,0,0,0" Padding="14,3" Height="28" />
        <TextBox x:Name="Line" Text="{Binding Sessions.Input, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Mono}"
                 FontSize="13" PreviewKeyDown="OnKeyDown" Height="28" />
    </DockPanel>
</UserControl>
