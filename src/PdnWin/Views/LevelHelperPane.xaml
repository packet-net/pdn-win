<UserControl x:Class="PdnWin.Views.LevelHelperPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PdnWin.Controls"
             xmlns:lv="clr-namespace:PdnWin.Core.Levels;assembly=PdnWin.Core">
    <UserControl.Resources>
        <Style x:Key="Step" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="LineHeight" Value="18" />
        </Style>
        <Style x:Key="Num" TargetType="Border">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{StaticResource AmberGlass}" />
            <Setter Property="BorderBrush" Value="{StaticResource AmberDim}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18,14,18,18" MaxWidth="620" HorizontalAlignment="Left">

            <TextBlock Text="Receive level" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource Step}" Foreground="{StaticResource Muted}" Margin="0,4,0,14">
                With the squelch open, an FM radio with nothing to hear makes steady hiss, and that hiss is what
                you set the level by. Clipping is what costs decodes; a quiet signal costs almost nothing.
            </TextBlock>

            <DockPanel Margin="0,0,0,10">
                <Border Style="{StaticResource Num}"><TextBlock Text="1" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Amber}" /></Border>
                <TextBlock Style="{StaticResource Step}">Set the radio's squelch <Bold>fully open</Bold> (SQL 0 on a Quansheng). You should hear, and see below, constant hiss.</TextBlock>
            </DockPanel>
            <DockPanel Margin="0,0,0,10">
                <Border Style="{StaticResource Num}"><TextBlock Text="2" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Amber}" /></Border>
                <TextBlock Style="{StaticResource Step}">Turn the radio's <Bold>volume</Bold> until the bar peaks in the green band, well clear of the red, with the CLIP light dark.</TextBlock>
            </DockPanel>

            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,4,0,12">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" x:Name="SetBadge" Background="#1F7BD88F" BorderBrush="{StaticResource Live}" BorderThickness="1"
                                CornerRadius="10" Padding="9,2" VerticalAlignment="Center"
                                Visibility="{Binding Levels.Settled, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="LEVEL SET" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Live}" />
                        </Border>
                        <TextBlock x:Name="Verdict" Text="{Binding Levels.Instruction}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </DockPanel>
                    <c:LevelMeter PeakDb="{Binding PeakDb}" RmsDb="{Binding RmsDb}" Height="22" Margin="0,12,0,4" />
                    <Grid>
                        <TextBlock Text="-60" FontFamily="{StaticResource Mono}" FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Left" />
                        <TextBlock Text="-18 ..... -9" FontFamily="{StaticResource Mono}" FontSize="10" Foreground="{StaticResource Good}" HorizontalAlignment="Center" Margin="170,0,0,0" />
                        <TextBlock Text="0 dBFS" FontFamily="{StaticResource Mono}" FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{Binding LevelText}" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{StaticResource Ink}" />
                        <Border Background="#7A1F14" CornerRadius="3" Padding="6,1" Margin="10,0,0,0"
                                Visibility="{Binding Clipping, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="CLIP" FontSize="10" FontWeight="Bold" Foreground="#FFD0C4" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <DockPanel Margin="0,0,0,10">
                <Border Style="{StaticResource Num}"><TextBlock Text="3" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Amber}" /></Border>
                <StackPanel>
                    <TextBlock Style="{StaticResource Step}">
                        Leave the Windows receive level at <Bold>0 dB</Bold> and use the radio's knob. Only if the knob's steps are too coarse,
                        trim it down here; it never goes above 0 dB.
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Slider Width="220" Minimum="{Binding RxMinDb}" Maximum="{Binding RxMaxDb}" Value="{Binding RxLevelDb}"
                                SmallChange="0.5" LargeChange="3" IsEnabled="{Binding LevelsAvailable}" />
                        <TextBlock Text="{Binding RxLevelDb, StringFormat='{}{0:0.0} dB'}" FontFamily="{StaticResource Mono}" FontSize="12"
                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <Border Height="1" Background="{StaticResource Edge}" Margin="0,14,0,16" />

            <TextBlock Text="Transmit level" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource Step}" Foreground="{StaticResource Muted}" Margin="0,4,0,14">
                Too much audio overdeviates and splatters into the next channel; it sounds fine to you and bad to everyone else.
                The Bessel null sets deviation without a meter: a single tone at the right deviation makes the carrier vanish.
            </TextBlock>

            <DockPanel Margin="0,0,0,10">
                <Border Style="{StaticResource Num}"><TextBlock Text="4" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Amber}" /></Border>
                <TextBlock Style="{StaticResource Step}">
                    Watch your own carrier on a second receiver: an SDR's waterfall, or a receiver in SSB mode. Pick the deviation you want
                    (2.4 kHz suits a 12.5 kHz channel; 5 kHz a 25 kHz one) and send the tone into a dummy load or on a clear frequency.
                </TextBlock>
            </DockPanel>

            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,4,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox ItemsSource="{Binding TxTestPresets}" SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Label" Width="300" />
                        <TextBox Text="{Binding TxTestSeconds}" Width="44" Margin="8,0,0,0" TextAlignment="Right" ToolTip="Seconds (at most 30)" />
                        <TextBlock Text="s" VerticalAlignment="Center" Margin="4,0,12,0" Foreground="{StaticResource Muted}" />
                        <Button x:Name="Go" Command="{Binding ToggleTxTestCommand}" Padding="16,4" IsEnabled="{Binding IsLive}">
                            <TextBlock x:Name="GoText" Text="Send tone" />
                        </Button>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Step}" Margin="0,12,0,6">
                        While it sends, raise the Windows transmit level from low until the carrier disappears. Stop there.
                    </TextBlock>
                    <StackPanel Orientation="Horizontal">
                        <Slider Width="260" Minimum="{Binding TxMinDb}" Maximum="{Binding TxMaxDb}" Value="{Binding TxLevelDb}"
                                SmallChange="0.5" LargeChange="2" IsEnabled="{Binding LevelsAvailable}" />
                        <TextBlock Text="{Binding TxLevelDb, StringFormat='{}{0:0.0} dB'}" FontFamily="{StaticResource Mono}" FontSize="12"
                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>

    <UserControl.Triggers />
</UserControl>
