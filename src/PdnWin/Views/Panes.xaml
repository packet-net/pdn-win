<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:PdnWin.Controls"
                    xmlns:vm="clr-namespace:PdnWin.ViewModels;assembly=PdnWin.Presentation">

    <!-- Monitor -->
    <!-- What an empty pane says, so it reads as waiting rather than broken. -->
    <Style x:Key="EmptyHint" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#4A5563" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="20" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <DataTemplate x:Key="MonitorPane" DataType="{x:Type vm:MainViewModel}">
        <Grid>
            <c:LogList ItemsSource="{Binding Monitor.Items}" Padding="0,4" />
            <TextBlock x:Name="Empty" Style="{StaticResource EmptyHint}" Visibility="Collapsed"
                       Text="Every frame heard or sent appears here, BPQ style." />
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Monitor.Items.Count}" Value="0">
                <Setter TargetName="Empty" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
    <DataTemplate x:Key="MonitorTools" DataType="{x:Type vm:MainViewModel}">
        <StackPanel Orientation="Horizontal">
            <ToggleButton IsChecked="{Binding Monitor.ShowSupervisory}" Content="RR/RNR" Margin="0,0,4,0"
                          ToolTip="Show supervisory frames (acknowledgements)" />
            <ToggleButton IsChecked="{Binding Monitor.Paused}" Content="Pause" Margin="0,0,4,0" ToolTip="Stop adding frames" />
            <Button Style="{StaticResource GhostButton}" Command="{Binding Monitor.ClearCommand}" Content="Clear" FontSize="11" />
        </StackPanel>
    </DataTemplate>

    <!-- Heard -->
    <DataTemplate x:Key="HeardPane" DataType="{x:Type vm:MainViewModel}">
        <Grid>
            <ListBox ItemsSource="{Binding Heard.Stations}" />
            <TextBlock x:Name="Empty" Style="{StaticResource EmptyHint}" Visibility="Collapsed"
                       Text="Stations appear here as they are heard, most recent first." />
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Heard.Stations.Count}" Value="0">
                <Setter TargetName="Empty" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Spectrum -->
    <DataTemplate x:Key="SpectrumPane" DataType="{x:Type vm:MainViewModel}">
        <c:SpectrumView Feed="{Binding Band}" Passband="{Binding Passband}" SpanHz="{Binding Settings.Ui.SpanHz}" Margin="0,4,0,0" />
    </DataTemplate>

    <!-- Waterfall -->
    <DataTemplate x:Key="WaterfallPane" DataType="{x:Type vm:MainViewModel}">
        <c:WaterfallView Feed="{Binding Band}" SpanHz="{Binding Settings.Ui.SpanHz}"
                         FloorDb="{Binding Settings.Ui.WaterfallFloorDb}" TopDb="{Binding Settings.Ui.WaterfallTopDb}" />
    </DataTemplate>

    <!-- Sessions -->
    <DataTemplate x:Key="SessionsPane" DataType="{x:Type vm:MainViewModel}">
        <TabControl ItemsSource="{Binding Sessions.Tabs}" SelectedItem="{Binding Sessions.Selected}"
                    ItemTemplate="{StaticResource SessionTabHeader}">
            <TabControl.ContentTemplate>
                <DataTemplate DataType="{x:Type vm:SessionTabViewModel}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Padding="10,5" BorderBrush="{StaticResource Edge}" BorderThickness="0,0,0,1"
                                x:Name="Bar">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="Disconnect" Command="{Binding DisconnectCommand}" Padding="10,2" FontSize="11"
                                            Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}" />
                                    <Button Content="Reconnect" Command="{Binding ReconnectCommand}" Padding="10,2" FontSize="11"
                                            Style="{StaticResource AccentButton}"
                                            Visibility="{Binding IsDown, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource MonoText}" FontSize="11" Foreground="{StaticResource Muted}">
                                    <Run Text="{Binding Title, Mode=OneTime}" Foreground="{StaticResource Amber}" /><Run Text="  " /><Run Text="{Binding State}" />
                                </TextBlock>
                            </DockPanel>
                        </Border>
                        <c:LogList ItemsSource="{Binding Lines}" Padding="0,6" />
                    </DockPanel>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsConsole}" Value="True">
                            <Setter TargetName="Bar" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </DataTemplate>
    <DataTemplate x:Key="SessionsTools" DataType="{x:Type vm:MainViewModel}">
        <StackPanel Orientation="Horizontal">
            <ComboBox IsEditable="True" Width="120" Height="24" MinHeight="24" ItemsSource="{Binding Sessions.RecentCalls}"
                      Text="{Binding Sessions.ConnectTo, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Mono}"
                      ToolTip="Callsign to connect to" x:Name="Call" />
            <Button Content="Connect" Command="{Binding Sessions.ConnectCommand}" Style="{StaticResource AccentButton}"
                    Padding="10,2" FontSize="11" Margin="5,0,0,0" IsDefault="False" />
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
