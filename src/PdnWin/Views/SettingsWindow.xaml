<Window x:Class="PdnWin.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PdnWin.ViewModels"
        xmlns:st="clr-namespace:PdnWin.Core.Settings;assembly=PdnWin.Core"
        Title="Settings" Width="760" Height="720" MinHeight="480" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}" Foreground="{StaticResource Ink}" FontFamily="{StaticResource Sans}"
        ShowInTaskbar="False" ResizeMode="CanResize" UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="5" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Amber}" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#5D6875" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12" />
        </Style>

        <!-- Interface cards: selectable, with a kind badge. -->
        <Style x:Key="InterfaceItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{StaticResource Panel2}" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="7" Padding="12,9">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3A4656" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Amber}" />
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AmberGlass}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource EdgeHi}" BorderThickness="1">
        <DockPanel>
            <Grid DockPanel.Dock="Top" Height="44" Background="{StaticResource Panel}">
                <TextBlock Text="Settings" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="20,0,0,0" />
                <Button HorizontalAlignment="Right" Style="{StaticResource GhostButton}" Width="44" Height="44" IsCancel="True"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="OnCancel">
                    <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{StaticResource Muted}" StrokeThickness="1.2" />
                </Button>
            </Grid>

            <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="0,1,0,0" Padding="20,12">
                <DockPanel>
                    <TextBlock Text="Saving restarts the station." Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Click="OnCancel" Padding="16,5" Margin="0,0,8,0" />
                        <Button Content="Save and restart" Click="OnSave" Style="{StaticResource AccentButton}" Padding="16,5"
                                IsEnabled="{Binding CanSave}" IsDefault="True" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="22,4,22,22">

                    <TextBlock Text="STATION" Style="{StaticResource Section}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Callsign" Style="{StaticResource Label}" Width="110" />
                                <TextBox Text="{Binding MyCall, UpdateSourceTrigger=PropertyChanged}" Width="160" FontFamily="{StaticResource Mono}"
                                         FontSize="14" CharacterCasing="Upper" x:Name="Call" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="110,6,0,0">With an SSID if you like, e.g. M0LTE-1. Used for every frame this station sends.</TextBlock>
                        </StackPanel>
                    </Border>

                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Rescan" Command="{Binding ScanCommand}" Padding="10,2" FontSize="11"
                                VerticalAlignment="Bottom" Margin="0,0,0,6" />
                        <TextBlock Text="RADIO INTERFACE" Style="{StaticResource Section}" />
                    </DockPanel>
                    <ListBox ItemsSource="{Binding Interfaces}" SelectedItem="{Binding SelectedInterface}" ItemContainerStyle="{StaticResource InterfaceItem}"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:InterfaceChoice}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" x:Name="Badge" CornerRadius="3" Padding="6,1" VerticalAlignment="Center" Background="#1A7C8894">
                                        <TextBlock Text="{Binding Kind}" FontSize="9.5" FontWeight="Bold" x:Name="BadgeText" Foreground="{StaticResource Muted}" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsRadio}" Value="True">
                                        <Setter TargetName="Badge" Property="Background" Value="#26F5A83C" />
                                        <Setter TargetName="BadgeText" Property="Foreground" Value="{StaticResource Amber}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding ScanResult}" />

                    <Border Style="{StaticResource Card}" Margin="0,6,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="PTT" Style="{StaticResource Label}" Width="110" />
                                <ComboBox ItemsSource="{Binding PttKinds}" SelectedItem="{Binding Ptt}" Width="200" x:Name="PttBox">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock x:Name="T" Text="{Binding}" />
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding}" Value="{x:Static st:PttKind.Cm108Hid}">
                                                    <Setter TargetName="T" Property="Text" Value="CM108 / AIOC HID" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding}" Value="{x:Static st:PttKind.Serial}">
                                                    <Setter TargetName="T" Property="Text" Value="Serial port line" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding}" Value="{x:Static st:PttKind.None}">
                                                    <Setter TargetName="T" Property="Text" Value="None (VOX)" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="GPIO" Style="{StaticResource Label}" Margin="18,0,8,0" x:Name="GpioLabel" />
                                <TextBox Text="{Binding Gpio}" Width="40" x:Name="GpioBox" TextAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" x:Name="SerialRow">
                                <TextBlock Text="Serial port" Style="{StaticResource Label}" Width="110" />
                                <ComboBox ItemsSource="{Binding SerialPorts}" SelectedItem="{Binding SerialPort}" Width="120" />
                                <CheckBox Content="DTR" IsChecked="{Binding SerialDtr}" Margin="16,0,0,0" VerticalAlignment="Center" />
                                <CheckBox Content="RTS" IsChecked="{Binding SerialRts}" Margin="14,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="110,8,0,0">
                                The AIOC keys on its HID (GPIO 3) or on its serial port with DTR set and RTS clear. HID leaves the serial port free.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="MODEM" Style="{StaticResource Section}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Mode" Style="{StaticResource Label}" Width="110" />
                                <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" Width="200" FontFamily="{StaticResource Mono}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock Text="TXDELAY" Style="{StaticResource Label}" Width="110" />
                                <TextBox Text="{Binding TxDelayMs}" Width="60" TextAlignment="Right" />
                                <TextBlock Text="ms" Style="{StaticResource Label}" Margin="6,0,24,0" />
                                <TextBlock Text="TXTAIL" Style="{StaticResource Label}" />
                                <TextBox Text="{Binding TxTailMs}" Width="50" TextAlignment="Right" />
                                <TextBlock Text="ms" Style="{StaticResource Label}" Margin="6,0,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="Persistence" Style="{StaticResource Label}" Width="110" />
                                <TextBox Text="{Binding Persistence}" Width="60" TextAlignment="Right" />
                                <TextBlock Text="/255" Style="{StaticResource Label}" Margin="6,0,24,0" />
                                <TextBlock Text="Slot time" Style="{StaticResource Label}" />
                                <TextBox Text="{Binding SlotTimeMs}" Width="50" TextAlignment="Right" />
                                <TextBlock Text="ms" Style="{StaticResource Label}" Margin="6,0,0,0" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="110,8,0,0">
                                TXDELAY is keyup to data. Handhelds take longer to come up than mobiles; 400 ms is a safe start for a Quansheng.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="SESSIONS" Style="{StaticResource Section}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox Content="Accept incoming connections" IsChecked="{Binding AcceptIncoming}" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock Text="Welcome text" Style="{StaticResource Label}" Width="110" />
                                <TextBox Text="{Binding WelcomeText}" Width="440" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="PACLEN" Style="{StaticResource Label}" Width="110" />
                                <TextBox Text="{Binding Paclen}" Width="60" TextAlignment="Right" />
                                <TextBlock Text="bytes per frame" Style="{StaticResource Label}" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="BEACON" Style="{StaticResource Section}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox Content="Send a beacon every" IsChecked="{Binding BeaconEnabled}" VerticalAlignment="Center" />
                                <TextBox Text="{Binding BeaconMinutes}" Width="50" Margin="8,0,6,0" TextAlignment="Right" />
                                <TextBlock Text="minutes (5 at least)" Style="{StaticResource Label}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock Text="To, via" Style="{StaticResource Label}" Width="110" />
                                <TextBox Text="{Binding BeaconPath}" Width="200" FontFamily="{StaticResource Mono}" CharacterCasing="Upper" />
                                <TextBlock Text="e.g. BEACON or ID,GB7RDG" Style="{StaticResource Hint}" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="Text" Style="{StaticResource Label}" Width="110" />
                                <TextBox Text="{Binding BeaconText}" Width="440" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
