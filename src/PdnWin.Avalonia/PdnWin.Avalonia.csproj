<Project Sdk="Microsoft.NET.Sdk">

  <!-- SPIKE: the same app on Avalonia, to judge whether one cross-platform front-end can replace
       the WPF one. Same view models (PdnWin.Presentation), same core, same Windows hardware on
       Windows; on Linux it runs the simulator until the Linux hardware layer exists. -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>pdn-win-avalonia</AssemblyName>
    <RootNamespace>PdnWin.Ava</RootNamespace>
    <ApplicationIcon>Assets\pdn-win.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <NoWarn>$(NoWarn);CA1812;AVLN3001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <ProjectReference Include="..\PdnWin.Presentation\PdnWin.Presentation.csproj" />
    <ProjectReference Include="..\PdnWin.Windows\PdnWin.Windows.csproj" />
  </ItemGroup>

</Project>
