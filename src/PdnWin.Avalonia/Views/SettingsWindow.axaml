<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:PdnWin.Hosting;assembly=PdnWin.Presentation"
        xmlns:st="clr-namespace:PdnWin.Core.Settings;assembly=PdnWin.Core"
        x:Class="PdnWin.Ava.Views.SettingsWindow"
        Title="Settings" Width="760" Height="720" MinHeight="480" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" CanResize="True">
    <Window.Styles>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="1.2" />
            <Setter Property="Foreground" Value="{StaticResource Amber}" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#5D6875" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
        <Style Selector="ListBox.interfaces ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="{StaticResource Panel2}" />
            <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="ListBox.interfaces ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AmberGlass}" />
            <Setter Property="BorderBrush" Value="{StaticResource Amber}" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                    <Button Content="Cancel" x:Name="Cancel" Padding="16,5" />
                    <Button Content="Save and restart" x:Name="Save" Classes="accent" Padding="16,5" IsEnabled="{Binding CanSave}" IsDefault="True" />
                </StackPanel>
                <TextBlock Text="Saving restarts the station." Classes="hint" VerticalAlignment="Center" Margin="0" />
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="22,4,22,22">
                <TextBlock Text="STATION" Classes="section" />
                <Border Classes="card">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Callsign" Classes="label" Width="110" />
                            <TextBox Text="{Binding MyCall}" Width="160" FontFamily="{StaticResource Mono}" FontSize="14" />
                        </StackPanel>
                        <TextBlock Classes="hint" Margin="110,6,0,0" Text="With an SSID if you like, e.g. M0LTE-1. Used for every frame this station sends." />
                    </StackPanel>
                </Border>

                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Rescan" Command="{Binding ScanCommand}" Padding="10,2" FontSize="11" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                    <TextBlock Text="RADIO INTERFACE" Classes="section" />
                </DockPanel>
                <ListBox Classes="interfaces" ItemsSource="{Binding Interfaces}" SelectedItem="{Binding SelectedInterface}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="h:InterfaceOption">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" CornerRadius="3" Padding="6,1" VerticalAlignment="Center" Background="#26F5A83C">
                                    <TextBlock Text="{Binding Kind}" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource Amber}" />
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Classes="hint" Text="{Binding ScanResult}" />

                <Border Classes="card" Margin="0,6,0,0">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="PTT" Classes="label" Width="110" />
                            <ComboBox ItemsSource="{Binding PttKinds}" SelectedItem="{Binding Ptt}" Width="200" />
                            <TextBlock Text="GPIO" Classes="label" Margin="18,0,8,0" />
                            <TextBox Text="{Binding Gpio}" Width="40" TextAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Serial port" Classes="label" Width="110" />
                            <ComboBox ItemsSource="{Binding SerialPorts}" SelectedItem="{Binding SerialPort}" Width="120" />
                            <CheckBox Content="DTR" IsChecked="{Binding SerialDtr}" Margin="16,0,0,0" />
                            <CheckBox Content="RTS" IsChecked="{Binding SerialRts}" Margin="14,0,0,0" />
                        </StackPanel>
                        <TextBlock Classes="hint" Margin="110,0,0,0" Text="The AIOC keys on its HID (GPIO 3) or on its serial port with DTR set and RTS clear. HID leaves the serial port free." />
                    </StackPanel>
                </Border>

                <TextBlock Text="MODEM" Classes="section" />
                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Mode" Classes="label" Width="110" />
                            <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" Width="200" FontFamily="{StaticResource Mono}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="TXDELAY" Classes="label" Width="110" />
                            <TextBox Text="{Binding TxDelayMs}" Width="60" TextAlignment="Right" />
                            <TextBlock Text="ms" Classes="label" Margin="6,0,24,0" />
                            <TextBlock Text="TXTAIL" Classes="label" />
                            <TextBox Text="{Binding TxTailMs}" Width="50" TextAlignment="Right" />
                            <TextBlock Text="ms" Classes="label" Margin="6,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Persistence" Classes="label" Width="110" />
                            <TextBox Text="{Binding Persistence}" Width="60" TextAlignment="Right" />
                            <TextBlock Text="/255" Classes="label" Margin="6,0,24,0" />
                            <TextBlock Text="Slot time" Classes="label" />
                            <TextBox Text="{Binding SlotTimeMs}" Width="50" TextAlignment="Right" />
                            <TextBlock Text="ms" Classes="label" Margin="6,0,0,0" />
                        </StackPanel>
                        <TextBlock Classes="hint" Margin="110,0,0,0" Text="TXDELAY is keyup to data. Handhelds take longer to come up than mobiles; 400 ms is a safe start for a Quansheng." />
                    </StackPanel>
                </Border>

                <TextBlock Text="SESSIONS" Classes="section" />
                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <CheckBox Content="Accept incoming connections" IsChecked="{Binding AcceptIncoming}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Welcome text" Classes="label" Width="110" />
                            <TextBox Text="{Binding WelcomeText}" Width="440" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="PACLEN" Classes="label" Width="110" />
                            <TextBox Text="{Binding Paclen}" Width="60" TextAlignment="Right" />
                            <TextBlock Text="bytes per frame" Classes="label" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="BEACON" Classes="section" />
                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="Send a beacon every" IsChecked="{Binding BeaconEnabled}" />
                            <TextBox Text="{Binding BeaconMinutes}" Width="50" Margin="8,0,6,0" TextAlignment="Right" />
                            <TextBlock Text="minutes (5 at least)" Classes="label" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="To, via" Classes="label" Width="110" />
                            <TextBox Text="{Binding BeaconPath}" Width="200" FontFamily="{StaticResource Mono}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Text" Classes="label" Width="110" />
                            <TextBox Text="{Binding BeaconText}" Width="440" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
