<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PdnWin.Ava.Views.InputPane">
    <DockPanel Margin="8,6" VerticalAlignment="Center">
        <TextBlock DockPanel.Dock="Left" Text="{Binding Sessions.Prompt}" FontFamily="{StaticResource Mono}" FontSize="13"
                   Foreground="{StaticResource Amber}" VerticalAlignment="Center" Margin="2,0,10,0" />
        <Button DockPanel.Dock="Right" Content="Send" Command="{Binding Sessions.SendCommand}" Classes="accent"
                Margin="8,0,0,0" Padding="14,3" Height="28" AutomationProperties.Name="Send" />
        <TextBox x:Name="Line" Text="{Binding Sessions.Input}" FontFamily="{StaticResource Mono}" FontSize="13" Height="28"
                 AutomationProperties.AutomationId="Line" />
    </DockPanel>
</UserControl>
